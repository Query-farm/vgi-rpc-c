@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(PkgConfig)
find_dependency(zstd CONFIG)
pkg_check_modules(LZ4 REQUIRED IMPORTED_TARGET liblz4)
if(NOT TARGET lz4::lz4)
    add_library(lz4::lz4 INTERFACE IMPORTED)
    target_link_libraries(lz4::lz4 INTERFACE PkgConfig::LZ4)
endif()
find_dependency(nanoarrow CONFIG)
pkg_check_modules(JSONC REQUIRED IMPORTED_TARGET json-c)
pkg_check_modules(SODIUM REQUIRED IMPORTED_TARGET libsodium)
pkg_check_modules(LIBEVENT REQUIRED IMPORTED_TARGET libevent libevent_pthreads)
pkg_check_modules(ZSTD REQUIRED IMPORTED_TARGET libzstd)
pkg_check_modules(CURL REQUIRED IMPORTED_TARGET libcurl)
find_dependency(ZLIB)
include("${CMAKE_CURRENT_LIST_DIR}/vgi_rpc-targets.cmake")
check_required_components(vgi_rpc)
